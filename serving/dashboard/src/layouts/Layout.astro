---
import ThemeToggle from "@/components/ui/theme-toggle";
import { sources } from "@/lib/queries";
import { turso } from "@/lib/turso";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Resolved from the current path so the nav can mark the active page. */
  active?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const NAV = [
  { href: "/", label: "Overview" },
  { href: "/analysis", label: "Analysis" },
  { href: "/stories", label: "Stories" },
  { href: "/catalog", label: "Catalog" },
  { href: "/explorer", label: "Explorer" },
  { href: "/sql", label: "SQL" },
  { href: "/ops", label: "Ops" },
  { href: "/docs", label: "Docs" },
];

// Attribution is a licence requirement for all three providers, so it lives in the layout
// rather than in each page where it could be forgotten.
//
// It is read from the `sources` table that the pipeline upserts on every run, so the
// footer cannot drift from the configuration the collectors actually use. The fallback is
// not decoration: a database problem must not take out every page on the site, and the
// attribution still has to render.
const FALLBACK_ATTRIBUTION: { label: string; attribution: string }[] = [
  { label: "NASA FIRMS", attribution: "Fire data: NASA FIRMS (MODIS and VIIRS active fire products)." },
  {
    label: "Copernicus Sentinel",
    attribution: "Imagery: Copernicus Sentinel-2 and Sentinel-1 (ESA), processed in Google Earth Engine.",
  },
  {
    label: "NOAA / NSIDC",
    attribution: "Ocean and ice data: NOAA OISST v2.1 and NSIDC Sea Ice Index (v4.0).",
  },
];

let attribution = FALLBACK_ATTRIBUTION;
try {
  const rows = await sources(turso(Astro.locals.runtime?.env ?? import.meta.env));
  if (rows.length > 0) {
    attribution = rows.map((row) => ({ label: row.label, attribution: row.attribution }));
  }
} catch {
  // keep the fallback
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Set before first paint: reading the preference in an island would flash the
      // default theme on every reload.
      try {
        const stored = localStorage.getItem("terrasentinel-theme");
        document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <div class="mx-auto flex min-h-screen max-w-7xl flex-col">
      <header class="border-b border-[var(--color-border)] px-4 pt-4">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <a href="/" class="text-lg font-semibold tracking-tight hover:text-[var(--color-accent)]">
            <svg
              viewBox="0 0 32 32"
              class="mr-1.5 inline-block h-[1.05em] w-[1.05em]"
              aria-hidden="true"
              focusable="false"
            >
              <rect width="32" height="32" rx="7" fill="#12161f" />
              <path d="M7.6 21.4 12.2 15.2 15.4 19.4 18.4 15.6 21 21.4Z" fill="#3d4f6b" />
              <path d="M10.4 21.4 15 16.6 17.6 19.6 20.4 14.8 24.4 21.4Z" fill="#9db3d1" />
              <path
                d="M16 4.2 26.1 10.1 26.1 21.9 16 27.8 5.9 21.9 5.9 10.1Z"
                fill="none"
                stroke="#e07b39"
                stroke-width="1.75"
                stroke-linejoin="round"
              />
              <circle cx="20.4" cy="14.8" r="2" fill="#e07b39" />
            </svg>TerraSentinel
          </a>
          <p class="text-xs text-[var(--color-muted)]">
            Satellite anomaly detection over EU study regions: wildfire, deforestation, cryosphere
          </p>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <nav class="flex flex-1 flex-wrap gap-x-1 gap-y-1 text-sm">
          {NAV.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-t border-b-2 px-3 py-2 transition-colors",
                isActive(item.href)
                  ? "border-[var(--color-accent)] text-[var(--color-foreground)]"
                  : "border-transparent text-[var(--color-muted)] hover:text-[var(--color-foreground)]",
              ]}
            >
              {item.label}
            </a>
            ))}
          </nav>
          <ThemeToggle client:only="react" />
        </div>
      </header>

      <main class="flex-1 px-4 py-5">
        <slot />
      </main>

      <footer class="border-t border-[var(--color-border)] px-4 py-4 text-xs text-[var(--color-muted)]">
        <p class="mb-1 font-medium text-[var(--color-foreground)]">Data attribution</p>
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
          {attribution.map((item) => (
            <li>{item.attribution}</li>
          ))}
        </ul>
        <p class="mt-2">
          Anomaly scores are statistical comparisons against each region's own seasonal baseline,
          or against the published NSIDC 1981–2010 normal. They are not official hazard warnings.
        </p>
        <p class="mt-1">
          Data is refreshed by scheduled GitHub Actions workflows; every figure on this site is a
          query against the serving database rather than a cached copy.
        </p>
      </footer>
    </div>
  </body>
</html>

# TerraSentinel — environment contract.
# Copy to `.env` (gitignored) and fill in. Never commit real values.
# In CI these come from GitHub Encrypted Secrets; on Cloudflare Pages from
# Pages environment variables. Code reads env vars only — no hardcoded secrets.

# --- Hugging Face (bronze + silver datasets, and the model registry) -----
# Put lake and model data in DATASET repos, not buckets: dataset repos are
# git-backed, which is what gives every model a dataset commit hash for lineage.
# (A model registry still needs its own *model* repo — repo type is part of the
# address on the Hub.)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Hugging Face username or organisation. Always required: repo ids are
# "owner/name" and a token does not imply the owner.
HF_NAMESPACE=swadhinbiswas
# All three repos derive from it (the project name is a code constant):
#   bronze lake        {HF_NAMESPACE}/TerraSentinel
#   silver             {HF_NAMESPACE}/TerraSentinel-silver
#   model registry     {HF_NAMESPACE}/TerraSentinel-models
# Optional: point any single store somewhere else instead of deriving it.
# HF_BRONZE_REPO=swadhinbiswas/TerraSentinel
# HF_SILVER_REPO=swadhinbiswas/TerraSentinel-silver
# HF_MODEL_REPO=swadhinbiswas/TerraSentinel-models

# --- NASA FIRMS (fire/thermal anomalies) ---------------------------------
# Request a key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Earth Engine (Sentinel-2 NDVI, Sentinel-1 SAR) --------------
# Path to the service-account JSON (never commit the file itself).
GEE_SERVICE_ACCOUNT_JSON=/absolute/path/to/gee-service-account.json
GEE_SERVICE_ACCOUNT_EMAIL=terrasentinel@your-project.iam.gserviceaccount.com
GEE_PROJECT=your-gcp-project-id

# --- ENTSO-E Transparency Platform (day-ahead price, actual load) --------
# Register at https://transparency.entsoe.eu/ and copy the "Token" from your
# account page. Quota is roughly 400 requests/hour; the collector paces itself.
ENTSOE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Turso (gold / serving layer) ---------------------------------------
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...
# Read-only token the dashboard prefers (see README → Credentials): create with
# `turso db tokens create <db> --read-only`.
TURSO_TOKEN_RO=eyJhbGciOi...

# --- Alerting ------------------------------------------------------------
# Discord: https://discord.com/api/webhooks/...   Slack: https://hooks.slack.com/services/...
ALERT_WEBHOOK_URL=

# --- MLflow (Phase 4+) ---------------------------------------------------
# Local SQLite default; a HF Space or remote tracking URI can override.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=terrasentinel-anomaly

# --- Optional: live inference API (not in the default path) -------------
INFERENCE_API_URL=
INFERENCE_API_TOKEN=
